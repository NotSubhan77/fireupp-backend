{
  "appId": "com.zovio.desktop.staging",
  "productName": "Zovio Staging",
  "extraMetadata": {
    "name": "zovio-desktop-staging",
    "productName": "Zovio Staging",
    "zovioStaging": true,
    "zovioServerUrl": "https://web-production-cd25c931.up.railway.app"
  },
  "directories": {
    "output": "dist-electron-staging"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json",
    "!dist-electron*/**"
  ],
  "asarUnpack": [
    "electron/native/**/*"
  ],
  "extraResources": [
    {
      "from": "resources/win-share",
      "to": "win-share"
    }
  ],
  "extraFiles": [
    {
      "from": "resources/win-share/Assets",
      "to": "Assets"
    }
  ],
  "afterPack": "electron/set-icon.js",
  "forceCodeSigning": false,
  "win": {
    "target": [
      "portable"
    ],
    "signAndEditExecutable": false,
    "icon": "public/icon.png"
  },
  "portable": {
    "artifactName": "Zovio_Staging_${version}.exe"
  }
}
